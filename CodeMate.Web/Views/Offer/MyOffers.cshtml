@model List<CodeMate.Web.Models.OfferViewModel>

@{
    ViewData["Title"] = "Verdiğim Teklifler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">📦 Verdiğim Teklifler</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">
            Henüz hiç teklif vermediniz.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Kurs ID</th>
                        <th>Fiyat</th>
                        <th>Onay Durumu</th>
                        <th>Tarih</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var offer in Model)
                    {
                        <tr>
                            <td><code>@offer.CourseId</code></td>
                            <td>@offer.OfferedPrice ₺</td>
                            <td>
                                @if (offer.IsApproved)
                                {
                                    <span class="badge bg-success">✅ Onaylandı</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">⏳ Bekliyor</span>
                                }
                            </td>
                            <td>@offer.CreatedAt.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
