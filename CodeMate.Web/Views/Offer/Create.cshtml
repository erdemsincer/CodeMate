@model CodeMate.Web.Models.OfferCreateViewModel

@{
    ViewData["Title"] = "Teklif Ver";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">🎯 Teklif Ver</h3>

                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="CourseId" />

                        <div class="mb-3">
                            <label asp-for="OfferedPrice" class="form-label">Teklif Fiyatı (₺)</label>
                            <input asp-for="OfferedPrice" class="form-control" placeholder="Örn: 500" />
                            <span asp-validation-for="OfferedPrice" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Teklifi Gönder</button>
                    </form>

                    <div class="text-center mt-3">
                        <a href="/Course" class="text-decoration-none">← Kurslara Geri Dön</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
