@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h2>Welcome to <span class="text-primary">CodeMate</span> 👋</h2>
        <p class="lead">
            This is your personalized dashboard. Use the navigation bar to manage offers, view messages, and explore new skills.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">🧑‍🏫 Mentorship</h5>
                    <p class="card-text">View and manage your mentor/mentee matches.</p>
                    <a href="/Matching" class="btn btn-outline-primary mt-auto">Go to Mentorship</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">💬 Chat</h5>
                    <p class="card-text">Continue your conversations with matched users.</p>
                    <a href="/Chat" class="btn btn-outline-primary mt-auto">Open Chat</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">🎯 Offers</h5>
                    <p class="card-text">See your active offers and respond to new opportunities.</p>
                    <a href="/Offer" class="btn btn-outline-primary mt-auto">View Offers</a>
                </div>
            </div>
        </div>
    </div>
</div>
