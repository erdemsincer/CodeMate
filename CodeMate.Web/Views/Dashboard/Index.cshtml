@model List<CodeMate.Web.Models.CourseViewModel>

@{
    ViewData["Title"] = "Available Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">📚 Available Courses</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning text-center">
            No courses available at the moment.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-primary">@course.Title</h5>
                            <p class="card-text flex-grow-1">@course.Description</p>
                            <div class="mt-3 d-flex justify-content-between align-items-center">
                                <small class="text-muted">📅 @course.CreatedAt.ToLocalTime().ToShortDateString()</small>
                                <a href="/Offer/Create?courseId=@course.Id" class="btn btn-sm btn-outline-success">Make Offer</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
